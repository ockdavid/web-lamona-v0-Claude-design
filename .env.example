# ─────────────────────────────────────────────────────────────
# la Mona — Environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# In Vite, only variables prefixed with VITE_ are exposed to
# the client-side code (accessible via import.meta.env.VITE_*).
# ─────────────────────────────────────────────────────────────

# Brand contact — used by the WhatsApp CTAs.
# Currently hardcoded in src/data/products.js — wire these in there if you
# want to source them from env instead.
VITE_WHATSAPP_NUMBER=51997918216
VITE_INSTAGRAM_URL=https://www.instagram.com/lamona_peru/
VITE_FACEBOOK_URL=https://www.facebook.com/share/1YAsh5Ffs1/

# Optional analytics — leave blank to disable.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=lamona.pe

# Optional Sentry for error tracking.
# VITE_SENTRY_DSN=
